{
  "name": "mark-judaya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx scripts/prerender.ts && cp public/CNAME dist/CNAME",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:nopr": "tsc -b && vite build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "theme:list": "node --import tsx scripts/apply-theme.ts --list",
    "theme:apply": "node --import tsx scripts/apply-theme.ts",
    "theme:apply:mineral": "node --import tsx scripts/apply-theme.ts mineral",
    "theme:apply:signal-brutalist": "node --import tsx scripts/apply-theme.ts signal-brutalist",
    "theme:apply:terminal-phosphor": "node --import tsx scripts/apply-theme.ts terminal-phosphor",
    "theme:apply:international-red": "node --import tsx scripts/apply-theme.ts international-red",
    "theme:apply:memphis-candy": "node --import tsx scripts/apply-theme.ts memphis-candy",
    "theme:apply:botanical-press": "node --import tsx scripts/apply-theme.ts botanical-press",
    "theme:apply:mediterranean-poster": "node --import tsx scripts/apply-theme.ts mediterranean-poster",
    "theme:apply:atelier-editorial": "node --import tsx scripts/apply-theme.ts atelier-editorial",
    "theme:apply:arctic-lab": "node --import tsx scripts/apply-theme.ts arctic-lab",
    "theme:apply:desert-western": "node --import tsx scripts/apply-theme.ts desert-western",
    "theme:apply:ultraviolet-club": "node --import tsx scripts/apply-theme.ts ultraviolet-club",
    "transition:list": "node --import tsx scripts/apply-transition.ts --list",
    "transition:apply": "node --import tsx scripts/apply-transition.ts",
    "transition:apply:relay-sweep": "node --import tsx scripts/apply-transition.ts relay-sweep",
    "transition:apply:ledger-diagonal": "node --import tsx scripts/apply-transition.ts ledger-diagonal",
    "transition:apply:hub-pulse": "node --import tsx scripts/apply-transition.ts hub-pulse",
    "transition:apply:split-handoff": "node --import tsx scripts/apply-transition.ts split-handoff",
    "transition:apply:line-scan": "node --import tsx scripts/apply-transition.ts line-scan",
    "transition:apply:validation-check": "node --import tsx scripts/apply-transition.ts validation-check",
    "transition:apply:alternating-routes": "node --import tsx scripts/apply-transition.ts alternating-routes",
    "transition:apply:signal-wave": "node --import tsx scripts/apply-transition.ts signal-wave",
    "transition:apply:cross-aperture": "node --import tsx scripts/apply-transition.ts cross-aperture",
    "transition:apply:packet-dissolve": "node --import tsx scripts/apply-transition.ts packet-dissolve",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^5.0.0",
    "globals": "^16.5.0",
    "postcss": "^8.4.24",
    "prettier": "^3.6.2",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    }
  }
}
