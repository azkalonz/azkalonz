  "narrative": {
    "northStar": "The Connected Workbench",
    "overview": "The portfolio feels like a bright working table where a client can see a business problem become a dependable system. Fine connection lines, purposeful nodes, interface fragments, and an original developer illustration make technical work tangible without turning the site into a diagramming tool or a collection of faux application windows. The world is friendly, capable, and calm. Cool daylight surfaces and generous breathing room keep long pages easy on the eyes. Illustration carries the expressive weight; interface chrome remains legible and composed. Motion demonstrates a workflow once, then settles.",
    "keyCharacteristics": [
      "Light-only cool daylight surfaces with deep navy text",
      "One continuous line language connecting illustrations and process",
      "Periwinkle, mint, coral, and sky accents with explicit roles",
      "Humanist grotesque typography with open counters and compact display rhythm",
      "Real screenshots and outcomes presented at editorial scale",
      "Restrained motion that explains sequence instead of decorating every element"
    ],
    "rules": [
      {
        "name": "The Daylight Majority Rule",
        "body": "Neutral daylight surfaces own at least three quarters of every screen. Accent color appears in meaningful fields and workflow states, not as scattered confetti.",
        "section": "colors"
      },
      {
        "name": "The No Gradient Type Rule",
        "body": "Emphasis comes from wording, weight, scale, or a single solid accent; display text is never gradient-filled.",
        "section": "colors"
      },
      {
        "name": "The Plain-Language Type Rule",
        "body": "Technical credibility comes from specific content, not monospace costuming, excessive tracking, or interface jargon.",
        "section": "typography"
      },
      {
        "name": "The Flat-by-Default Rule",
        "body": "A border or a shadow establishes a surface at rest, never both. Shadows appear because an object overlaps another plane, not because every container needs elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do let one authored illustration or real project screenshot dominate a composition.",
      "Do use accent colors to explain workflow roles and state.",
      "Do show real services, tools, process, and case-study outcomes.",
      "Do keep interfaces spacious, direct, keyboard accessible, and readable in daylight.",
      "Do make motion reveal sequence once and provide a complete reduced-motion state."
    ],
    "donts": [
      "Don't recreate the previous dark terminal, neon, glitch, grid, or faux-telemetry world.",
      "Don't build pages from repeated equal-sized icon cards or floating browser windows.",
      "Don't use glassmorphism, decorative blur, gradient text, excessive pills, or ambient blobs.",
      "Don't imply AI expertise, clients, metrics, or testimonials without supplied evidence.",
      "Don't shrink dense desktop labels below legibility; remove or recompose them."
    ]
  }
}
